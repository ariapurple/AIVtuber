# Shared Docker network with jwilder/nginx-proxy on the host
NGINX_PROXY_NETWORK=web_proxy

# Public vhost (DNS A record -> Layerstack server)
VIRTUAL_HOST=ai-trainning.innovationowl.com
LETSENCRYPT_HOST=ai-trainning.innovationowl.com
# Optional: email for Let's Encrypt notices
LETSENCRYPT_EMAIL=

# App
AILIVE2D_SECRET=replace-with-long-random-string
# From Layerstack, point at a reachable Ollama URL (LAN IP only works on LAN)
AILIVE2D_LLM_BASE_URL=http://192.168.50.226:11434
AILIVE2D_AUTH=1